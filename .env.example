# Variaveis de ambiente (exemplo)
# Copie este arquivo para .env para testes locais.
# Em provedor, configure as variaveis no painel do servico.

# Rede/porta
HOST=0.0.0.0
PORT=3000

# Caminho do arquivo de dados
DATA_PATH=./depoimentos.json

# CORS: vazio = aberto (desenvolvimento); em producao use dominios separados por virgula.
# CORS_ORIGINS=https://www.seudominio.com,https://app.seudominio.com

# Token admin para proteger DELETE /api/depoimentos/:id (opcional, recomendado em producao)
# ADMIN_TOKEN=troque-por-um-token-forte
